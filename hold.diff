@@ -1115,6 +1128,19 @@ async function saveOnlyPaneWithSavePage(win, filePath, format /* 'HTMLOnly' | 'M
     if (key) {
       try { await win.webContents.removeInsertedCSS(key); } catch {}
     }
+    // --- POST-EXPORT NORMALIZATION ---
+    // Ensure root scrolling is restored to the desired state so we don't end up
+    // with a second vertical scrollbar lingering after export flows.
+    // (html: non-scrollable vertically; body: single vertical scroll context)
+    try {
+      await win.webContents.insertCSS(`
+        html { overflow-y: hidden !important; }
+        @supports (overflow: clip) {
+          html, body { overflow-x: clip !important; }
+        }
+        body { overflow-y: auto !important; }
