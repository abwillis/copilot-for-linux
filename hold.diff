--- a/main.js
+++ b/main.js
@@ -255,12 +255,25 @@ function buildMaxLayoutCSS({ specificMessageId } = {}) {
       padding-left: 0 !important;
       padding: 0 !important;
       overflow-x: hidden !important;
-      overflow-y: auto !important;
