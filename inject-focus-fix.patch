+function queueInject(win, envelope) {
+  if (!win || win.isDestroyed()) return;
+  const wc = win.webContents;
+  const id = wc.id;
+  const arr = pendingInjectByWC.get(id) || [];
+  arr.push(envelope);
+  pendingInjectByWC.set(id, arr);
