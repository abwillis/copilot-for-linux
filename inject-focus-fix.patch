+    try {
+      const frames = root.querySelectorAll?.('iframe') || [];
+      for (const f of frames) {
+        try {
+          const doc = f.contentDocument;
+          if (doc) queue.push(doc);
+        } catch {}
+      }
+    } catch {}
+  }
+  return null;
+}
