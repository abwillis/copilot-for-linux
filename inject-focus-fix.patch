+
+function flushInject(win) {
+  if (!win || win.isDestroyed()) return;
+  const wc = win.webContents;
+  const id = wc.id;
+  const arr = pendingInjectByWC.get(id);
+  if (!arr || !arr.length) return;
+  pendingInjectByWC.delete(id);
+  for (const env of arr) {
+    try { wc.send(IPC.INJECT_ENVELOPE, env); } catch {}
+  }
+}
+
+function sendInjectWhenReady(win, envelope) {
+  if (!win || win.isDestroyed()) return;
+  const wc = win.webContents;
+  if (wc.isLoading()) {
+    queueInject(win, envelope);
+    return;
+  }
+  try { wc.send(IPC.INJECT_ENVELOPE, envelope); } catch { queueInject(win, envelope); }
+  setTimeout(() => flushInject(win), 150);
+  setTimeout(() => flushInject(win), 500);
+}
