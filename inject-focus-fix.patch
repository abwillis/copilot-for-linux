+function queryDeep(selector) {
+  // Breadth-first traversal across DOM + shadow roots.
+  // NOTE: cannot pierce cross-origin iframes.
+  const seen = new Set();
+  const queue = [document];
+  while (queue.length) {
+    const root = queue.shift();
+    if (!root || seen.has(root)) continue;
+    seen.add(root);
+
+    try {
+      const hit = root.querySelector?.(selector);
+      if (hit) return hit;
+    } catch {}
